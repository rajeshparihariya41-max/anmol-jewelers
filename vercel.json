{
  "rewrites": [
    {
      "source": "/",
      "destination": "/catalog/live/index.html"
    },
    {
      "source": "/catalog/live",
      "destination": "/catalog/live/index.html"
    },
    {
      "source": "/catalog/live/",
      "destination": "/catalog/live/index.html"
    }
  ],
  "headers": [
    {
      "source": "/catalog/live/data.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    },
    {
      "source": "/api/live-catalog",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
