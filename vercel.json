{
  "rewrites": [
    {
      "source": "/",
      "destination": "/catalog/live/index.html"
    },
    {
      "source": "/catalog/live",
      "destination": "/catalog/live/index.html"
    },
    {
      "source": "/catalog/live/",
      "destination": "/catalog/live/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/catalog/live/assets/:path*"
    },
    {
      "source": "/data.json",
      "destination": "/catalog/live/data.json"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/catalog/live",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/catalog/live/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/catalog/live/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/live-catalog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
